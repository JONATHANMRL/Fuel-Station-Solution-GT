# Plantilla sin secretos. No se carga automáticamente: configurar el entorno
# del proceso o un EnvironmentFile privado del servicio en Oracle Linux.
ORACLE_ENABLED=false
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=
ORACLE_PASSWORD=
# Propietario de las vistas, si la cuenta de lectura es otra. Identificador simple.
ORACLE_SCHEMA=
ORACLE_POOL_MAX=4
ORACLE_POOL_WAIT_MS=5000
ORACLE_CONNECT_TIMEOUT_S=5
ORACLE_CALL_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 3: private only. No test user is implicitly authorized.
AUTH_ENABLED=false
AUTH_ADMIN_USER_IDS=
# Separate account; never GASOLINAGT_API. Same host/service/schema as reads.
AUTH_ORACLE_USER=
AUTH_ORACLE_PASSWORD=
# Absolute path OUTSIDE the project, in an operator-provisioned private directory.
AUTH_SESSION_DB=
AUTH_SESSION_TTL_SECONDS=1800
# none permits localhost frontend -> HTTPS tailnet API (subject to browser policy).
# Prefer lax when frontend/API are served on the same site.
AUTH_COOKIE_SAMESITE=none
# If omitted, inherits CORS_ORIGINS. Exact allowed frontend origins only.
# AUTH_ALLOWED_ORIGINS=https://frontend.example.invalid

# Phases 4/5: third private service account; existing read/auth credentials unchanged.
OPERATIONS_ORACLE_USER=
OPERATIONS_ORACLE_PASSWORD=
PRICE_WRITES_ENABLED=false
ORACLE_NOTIFICATIONS_ENABLED=false
# Oracle TIMESTAMP columns have no timezone. Confirm historical convention first.
# Applied only to the new operations pool and JSON conversion, never old read/auth pools.
ORACLE_DATA_UTC_OFFSET=-06:00

# Optional actual activation instant (ISO 8601 WITH timezone), set once by operator.
# Empty = historical origin unclassified; never invent a demo/live cutoff.
PUBLIC_PRICE_ALERTS_ACTIVATED_AT=
